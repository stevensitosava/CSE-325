
@model IEnumerable<StevenMovies.Models.Movie>

@{
    ViewData["Title"] = "My Movies";
}

<div class="container mt-4">
    <h1>My Movies</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            Add New Movie
        </a>
    </p>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-3">

            <div class="col-md-5">
                <label class="form-label">Search by title</label>
                <input type="text"
                       name="searchString"
                       value="@ViewBag.SearchString"
                       class="form-control"
                       placeholder="Enter movie title..." />
            </div>

            <div class="col-md-4">
                <label class="form-label">Release year or newer</label>

                <select name="year" class="form-select">
                    <option value="">All years</option>

                    @foreach (int availableYear in ViewBag.Years)
                    {
                        <option value="@availableYear"
                                selected="@(ViewBag.SelectedYear == availableYear)">
                            @availableYear
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Reset
                </a>
            </div>

        </div>
    </form>

    @if (!Model.Any())
    {
        <p>No movies have been added yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Release Date</th>
                    <th>Genre</th>
                    <th>Price</th>
                    <th>Rating</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var movie in Model)
                {
                    <tr>
                        <td>@movie.Title</td>
                        <td>@movie.ReleaseDate.ToShortDateString()</td>
                        <td>@movie.Genre</td>
                        <td>@movie.Price.ToString("C")</td>
                        <td>@movie.Rating</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@movie.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@movie.Id"
                               class="btn btn-info btn-sm">
                                Details
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@movie.Id"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
